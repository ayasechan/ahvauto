{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "svelte": true,
  "ignorePatterns": ["dist/**", "legacy/**", "logs/**", "__tmp-*/**"]
}
